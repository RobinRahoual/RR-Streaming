{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robin.player/schemas/sources.v1.json",
  "title": "Liste de sources",
  "description": "Fichier importé dans l'onglet Sources. Les métadonnées viennent de TMDB ; une source sert uniquement à trouver la page de lecture d'un titre puis à la passer au MediaUrlInterceptor.",
  "type": "object",
  "required": ["schemaVersion", "providers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "maxLength": 60, "description": "Nom affiché de la liste." },
    "description": { "type": "string", "maxLength": 280 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["css"],
      "additionalProperties": false,
      "properties": {
        "css": { "type": "string", "description": "Sélecteur CSS relatif à l'élément courant. Chaîne vide = l'élément lui-même." },
        "attr": { "type": "string", "default": "text", "description": "\"text\", \"html\" ou nom d'attribut (href, src, data-src…). Les URLs sont rendues absolues." },
        "regex": { "type": "string", "description": "Optionnel. Applique la regex sur la valeur ; le groupe 1 est conservé s'il existe." }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "baseUrl", "search"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,47}$", "description": "Identifiant unique et stable. Une source locale avec le même id remplace celle d'une liste." },
        "name": { "type": "string", "maxLength": 40 },
        "enabled": { "type": "boolean", "default": true },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50, "description": "Plus grand = essayé en premier." },
        "baseUrl": { "type": "string", "pattern": "^https?://" },
        "language": { "type": "string", "description": "Code ISO 639-1 (fr, en…)." },
        "types": {
          "type": "array",
          "items": { "enum": ["movie", "tv"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["movie", "tv"]
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Headers HTTP envoyés pour la recherche et les pages."
        },
        "search": {
          "type": "object",
          "required": ["url", "item", "title", "link"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "description": "Variables : {baseUrl}, {query}. Ex : {baseUrl}/recherche?q={query}" },
            "query": { "type": "string", "default": "{title}", "description": "Construit {query}. Variables TMDB : {title}, {originalTitle}, {year}, {type}." },
            "item": { "type": "string", "description": "Sélecteur CSS d'un résultat." },
            "title": { "$ref": "#/$defs/selector" },
            "link": { "$ref": "#/$defs/selector" },
            "year": { "$ref": "#/$defs/selector" },
            "poster": { "$ref": "#/$defs/selector" }
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minScore": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8, "description": "Similarité minimale entre le titre TMDB et le titre du résultat." },
            "yearTolerance": { "type": "integer", "minimum": 0, "maximum": 3, "default": 1 }
          }
        },
        "episodes": {
          "type": "object",
          "additionalProperties": false,
          "description": "Requis si types contient \"tv\". urlTemplate et/ou params, ou item + season + episode + link (parsing de la page de la série).",
          "properties": {
            "urlTemplate": { "type": "string", "description": "Variables : {link}, {season}, {episode}, {season2}, {episode2} (sur 2 chiffres)." },
            "params": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Paramètres d'adresse ajoutés ou remplacés sur la page de la série (ou sur urlTemplate). Ex. : { \"s\": \"{season}\", \"ep\": \"{episode}\" }."
            },
            "item": { "type": "string" },
            "season": { "$ref": "#/$defs/selector" },
            "episode": { "$ref": "#/$defs/selector" },
            "link": { "$ref": "#/$defs/selector" }
          }
        },
        "player": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options passées au MediaUrlInterceptor.",
          "properties": {
            "iframe": { "$ref": "#/$defs/selector", "description": "Si présent, on charge directement l'iframe du lecteur au lieu de la page." },
            "allowedHosts": { "type": "array", "items": { "type": "string" } },
            "extraHlsPattern": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 3000, "maximum": 60000 }
          }
        }
      }
    }
  }
}
